# Aucune clé API de modèle nécessaire pour le site et l’intégration ChatGPT.
# Après déploiement : origine HTTPS réelle du site, sans chemin.
JOBSCOUT_PUBLIC_URL=

# Optionnel en environnement cloud avec un proxy HTTP(S) fourni par la plateforme.
# NODE_USE_ENV_PROXY=1

# Mode original strictement local seulement ; laisser désactivé sur un serveur public.
# JOBSCOUT_ENABLE_LOCAL_APP=1
